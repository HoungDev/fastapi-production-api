# Local development configuration
# `python scripts/dev.py setup` copies this file to `.env` and replaces the
# placeholder SECRET_KEY with a generated value. Never use these credentials in
# a deployed environment.

# Application
APP_NAME=FastAPI Production API
ENVIRONMENT=development
DEBUG=true


# Database
DATABASE_URL=postgresql+psycopg://fastapi_user:fastapi_password@localhost:5432/fastapi_db


# JWT Configuration
SECRET_KEY=change_this_to_a_random_secret_key
ALGORITHM=HS256


# Token Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# JWT Claims
JWT_AUDIENCE=fastapi-client
JWT_ISSUER=fastapi-production-api


# CORS
CORS_ORIGINS=http://localhost:3000
