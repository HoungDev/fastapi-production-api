# Local development configuration
# `python scripts/dev.py setup` copies this file to `.env` and replaces the
# placeholder SECRET_KEY with a generated value. Never use these credentials in
# a deployed environment.

# Application
APP_NAME=FastAPI Production API
ENVIRONMENT=development
DEBUG=true


# Database
DATABASE_URL=postgresql+psycopg://fastapi_user:fastapi_password@localhost:5432/fastapi_db


# JWT Configuration
SECRET_KEY=change_this_to_a_random_secret_key
ALGORITHM=HS256


# Token Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# JWT Claims
JWT_AUDIENCE=fastapi-client
JWT_ISSUER=fastapi-production-api


# CORS
CORS_ORIGINS=http://localhost:3000


# Redis and request rate limiting. Memory mode preserves single-process setup.
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1
REDIS_MAX_CONNECTIONS=20
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_LIMIT=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAILURE_MODE=closed
RATE_LIMIT_KEY_SECRET=change_this_to_a_random_rate_limit_key


# Email verification (disabled until an SMTP provider is configured)
EMAIL_DELIVERY_MODE=disabled
OUTBOX_ENCRYPTION_KEY=change_this_to_a_random_outbox_key
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE_SECONDS=30
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_BASE_SECONDS=5
OUTBOX_BACKOFF_MAX_SECONDS=300
OUTBOX_SHUTDOWN_GRACE_SECONDS=30
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30


# TOTP MFA (generate a dedicated Fernet key before enabling)
MFA_ENABLED=false
MFA_ISSUER=FastAPI Production API
MFA_ENCRYPTION_KEY=
MFA_ENROLLMENT_EXPIRE_MINUTES=10
MFA_CHALLENGE_EXPIRE_MINUTES=5
MFA_RECOVERY_CODE_COUNT=10
MFA_STEP_UP_MAX_AGE_MINUTES=10


# OpenID Connect Authorization Code + PKCE (disabled by default)
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/oidc/callback
OIDC_SCOPES=openid email profile
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
OIDC_TRANSACTION_ENCRYPTION_KEY=
OIDC_TRANSACTION_EXPIRE_MINUTES=5
OIDC_RECENT_AUTH_MAX_AGE_MINUTES=10
OIDC_HTTP_TIMEOUT_SECONDS=5
OIDC_CACHE_BACKEND=none
OIDC_DISCOVERY_CACHE_TTL_SECONDS=300
OIDC_JWKS_CACHE_TTL_SECONDS=300
OIDC_CACHE_REFRESH_LOCK_SECONDS=5
OIDC_CACHE_REFRESH_WAIT_SECONDS=1
OIDC_CACHE_MAX_DOCUMENT_BYTES=262144


# OpenTelemetry tracing (disabled by default)
TRACING_ENABLED=false
OTEL_SERVICE_NAME=fastapi-production-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORT_TIMEOUT_SECONDS=5
OTEL_TRACE_SAMPLE_RATIO=1.0
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
