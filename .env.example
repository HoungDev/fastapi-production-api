# Local development configuration
# `python scripts/dev.py setup` copies this file to `.env` and replaces the
# placeholder SECRET_KEY with a generated value. Never use these credentials in
# a deployed environment.

# Application
APP_NAME=FastAPI Production API
ENVIRONMENT=development
DEBUG=true


# Database
DATABASE_URL=postgresql+psycopg://fastapi_user:fastapi_password@localhost:5432/fastapi_db


# JWT Configuration
SECRET_KEY=change_this_to_a_random_secret_key
ALGORITHM=HS256


# Token Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# JWT Claims
JWT_AUDIENCE=fastapi-client
JWT_ISSUER=fastapi-production-api


# CORS
CORS_ORIGINS=http://localhost:3000


# Email verification (disabled until an SMTP provider is configured)
EMAIL_DELIVERY_MODE=disabled
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
