# Application
APP_NAME=FastAPI Production API

ENVIRONMENT=production

DEBUG=false

LOG_LEVEL=INFO


# Database

DATABASE_URL=postgresql+psycopg://fastapi_user:strong_password@localhost:5432/fastapi_db


# JWT Configuration

SECRET_KEY=generate_a_secure_random_secret_key

ALGORITHM=HS256


# Token Configuration

ACCESS_TOKEN_EXPIRE_MINUTES=30

REFRESH_TOKEN_EXPIRE_DAYS=7


# JWT Claims

JWT_AUDIENCE=fastapi-client

JWT_ISSUER=fastapi-production-api


# CORS

CORS_ORIGINS=https://your-domain.com


# Redis and distributed request rate limiting

REDIS_URL=rediss://app:password@redis.internal.example:6379/0

REDIS_CONNECT_TIMEOUT_SECONDS=1

REDIS_SOCKET_TIMEOUT_SECONDS=1

REDIS_MAX_CONNECTIONS=50

RATE_LIMIT_BACKEND=redis

RATE_LIMIT_LIMIT=100

RATE_LIMIT_WINDOW_SECONDS=60

RATE_LIMIT_FAILURE_MODE=closed

RATE_LIMIT_KEY_SECRET=generate_a_secure_random_rate_limit_key


# Email verification

EMAIL_DELIVERY_MODE=smtp

EMAIL_VERIFICATION_URL=https://your-frontend.example/verify-email

EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=30

PASSWORD_RESET_URL=https://your-frontend.example/reset-password

PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

MFA_ENABLED=true

MFA_ISSUER=FastAPI Production API

MFA_ENCRYPTION_KEY=generate-and-store-a-dedicated-fernet-key

MFA_ENROLLMENT_EXPIRE_MINUTES=10

MFA_CHALLENGE_EXPIRE_MINUTES=5

MFA_RECOVERY_CODE_COUNT=10

MFA_STEP_UP_MAX_AGE_MINUTES=10

OIDC_ENABLED=false

OIDC_ISSUER=https://identity-provider.example

OIDC_CLIENT_ID=replace-with-provider-client-id

OIDC_CLIENT_SECRET=store-in-your-secrets-manager

OIDC_REDIRECT_URI=https://api.your-domain.com/auth/oidc/callback

OIDC_SCOPES=openid email profile

OIDC_ALLOWED_ALGORITHMS=RS256

OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic

OIDC_TRANSACTION_ENCRYPTION_KEY=generate-and-store-a-dedicated-fernet-key

OIDC_TRANSACTION_EXPIRE_MINUTES=5

OIDC_RECENT_AUTH_MAX_AGE_MINUTES=10

OIDC_HTTP_TIMEOUT_SECONDS=5

SMTP_HOST=smtp.example.com

SMTP_PORT=587

SMTP_USERNAME=mailer

SMTP_PASSWORD=store-in-your-secrets-manager

SMTP_FROM=security@your-domain.com

SMTP_STARTTLS=true

SMTP_TIMEOUT_SECONDS=10
