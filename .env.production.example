# Application
APP_NAME=FastAPI Production API

ENVIRONMENT=production

DEBUG=false

LOG_LEVEL=INFO


# Database

DATABASE_URL=postgresql+psycopg://fastapi_user:strong_password@localhost:5432/fastapi_db


# JWT Configuration

SECRET_KEY=generate_a_secure_random_secret_key

ALGORITHM=HS256


# Token Configuration

ACCESS_TOKEN_EXPIRE_MINUTES=30

REFRESH_TOKEN_EXPIRE_DAYS=7


# JWT Claims

JWT_AUDIENCE=fastapi-client

JWT_ISSUER=fastapi-production-api


# CORS

CORS_ORIGINS=https://your-domain.com


# Email verification

EMAIL_DELIVERY_MODE=smtp

EMAIL_VERIFICATION_URL=https://your-frontend.example/verify-email

EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=30

PASSWORD_RESET_URL=https://your-frontend.example/reset-password

PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

MFA_ENABLED=true

MFA_ISSUER=FastAPI Production API

MFA_ENCRYPTION_KEY=generate-and-store-a-dedicated-fernet-key

MFA_ENROLLMENT_EXPIRE_MINUTES=10

MFA_CHALLENGE_EXPIRE_MINUTES=5

MFA_RECOVERY_CODE_COUNT=10

MFA_STEP_UP_MAX_AGE_MINUTES=10

SMTP_HOST=smtp.example.com

SMTP_PORT=587

SMTP_USERNAME=mailer

SMTP_PASSWORD=store-in-your-secrets-manager

SMTP_FROM=security@your-domain.com

SMTP_STARTTLS=true

SMTP_TIMEOUT_SECONDS=10
