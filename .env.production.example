# Application
APP_NAME=FastAPI Production API

ENVIRONMENT=production

DEBUG=false

LOG_LEVEL=INFO


# Database

DATABASE_URL=postgresql+psycopg://fastapi_user:strong_password@localhost:5432/fastapi_db


# JWT Configuration

SECRET_KEY=generate_a_secure_random_secret_key

ALGORITHM=HS256


# Token Configuration

ACCESS_TOKEN_EXPIRE_MINUTES=30

REFRESH_TOKEN_EXPIRE_DAYS=7


# JWT Claims

JWT_AUDIENCE=fastapi-client

JWT_ISSUER=fastapi-production-api


# CORS

CORS_ORIGINS=https://your-domain.com