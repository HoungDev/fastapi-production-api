DATABASE_URL=postgresql+psycopg://user:password@postgres.example:5432/fastapi_db
SECRET_KEY=replace-with-a-generated-secret-of-at-least-32-bytes
MFA_ENCRYPTION_KEY=replace-with-a-fernet-key
REDIS_URL=rediss://app:password@redis.example:6379/0
RATE_LIMIT_KEY_SECRET=replace-with-a-separate-random-secret-of-at-least-32-bytes
OUTBOX_ENCRYPTION_KEY=replace-with-a-fernet-key
SMTP_HOST=smtp.example.com
SMTP_FROM=security@your-domain.example
SMTP_PASSWORD=replace-with-secret-manager-value
